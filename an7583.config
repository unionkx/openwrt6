CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
# CONFIG_HOST_OS_MACOS is not set
CONFIG_DEFAULT_TARGET_airoha_an7583=y
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7583=y
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_airoha_an7583_DEVICE_airoha_an7583-evb is not set
# CONFIG_TARGET_airoha_an7583_DEVICE_airoha_an7583-evb-emmc is not set
# CONFIG_TARGET_airoha_an7583_DEVICE_nokia_xg-040g-mf is not set
# CONFIG_TARGET_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi is not set

# CONFIG_TARGET_DEVICE_airoha_an7583_DEVICE_airoha_an7583-evb-emmc is not set
# CONFIG_TARGET_DEVICE_airoha_an7583_DEVICE_airoha_an7583-evb is not set
CONFIG_TARGET_DEVICE_airoha_an7583_DEVICE_nokia_xg-040g-mf=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7583_DEVICE_nokia_xg-040g-mf=""
CONFIG_TARGET_DEVICE_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi=""
# end of Target Devices
CONFIG_PACKAGE_luci=y
